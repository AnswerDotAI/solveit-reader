{
  "manifest_version": 3,
  "name": "Solveit Reader",
  "version": "3.0",
  "description": "Import any webpage into Solveit for reading and annotation",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
